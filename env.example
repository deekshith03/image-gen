# Copy to .env and fill in:   cp env.example .env
#
# All model calls (Gemini image + planner, Claude judge, expert panel) go through a LiteLLM proxy.
# Without these, `test`, `verify` and `score` still work; generating or re-judging ads does not.
LITELLM_BASE_URL=https://your-litellm-proxy.example.com
LITELLM_API_KEY=

# Host port. The app is reachable from this machine only; APP_BIND=0.0.0.0 shares it on your network
# (it has no login).
APP_BIND=127.0.0.1
APP_PORT=8501
